{
  "name": "freelance-client-react",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "webpack serve --config webpack.config.js --env development --host 0.0.0.0 --port 3000 --allowed-hosts all",
    "build": "webpack --config webpack.config.js --env production",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
